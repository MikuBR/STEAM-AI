# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# STEAM_API_KEY: Required to access the Steam Web API.
# Get yours at https://steamcommunity.com/dev/apikey
STEAM_API_KEY="MY_STEAM_API_KEY"

# APP_URL: Used for Steam OAuth callback, e.g. https://your-app.onrender.com
APP_URL="http://localhost:3000"

# SESSION_SECRET: Used to sign session cookies.
SESSION_SECRET="change-me-to-a-random-string"

# VITE_API_URL: Frontend build-time env. Points to the backend URL in production.
# Leave empty in development (Vite proxy handles it).
# On Render: set via render.yaml automatically.
# Local dev: not needed.
VITE_API_URL=""
